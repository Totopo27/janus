# Janus Configuration Template
# Rename this file to .env to configure your local or cloud providers.

# BYOM - Cloud LLM (Google Gemini Flash)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# BYOM - Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Application Server Settings
JANUS_PORT=8000
JANUS_HOST=0.0.0.0
JANUS_DB_PATH=janus.db
